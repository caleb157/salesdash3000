# --- Odoo connection (Odoo Online needs the Custom plan for API access) ---
ODOO_URL=https://parableventures.odoo.com
ODOO_DB=parableventures
ODOO_LOGIN=parker@parable-ventures.com
ODOO_API_KEY=

# --- Dashboard login ---
DASHBOARD_PASSWORD=
# Any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# --- Business settings ---
# Annual goals in company currency, comma separated
GOALS=140000,175000,240000
# Month the financial year starts (1 = January, 4 = April, 7 = July ...)
FY_START_MONTH=1
# Time zone used to decide which day/month an order falls in
TIMEZONE=America/Los_Angeles
# untaxed | total
AMOUNT_BASIS=untaxed
# Subtract credit notes from invoiced totals (true | false)
INCLUDE_CREDIT_NOTES=true

# Set to true to run with generated demo data (no Odoo calls)
DEMO_MODE=false
