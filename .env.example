# --- Odoo connection (Odoo Online needs the Custom plan for API access) ---
ODOO_URL=https://parableventures.odoo.com
ODOO_DB=parableventures
ODOO_LOGIN=parker@parable-ventures.com
ODOO_API_KEY=

# --- Dashboard login ---
DASHBOARD_PASSWORD=
# Any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# --- Business settings ---
# Annual goals, comma separated, "<amount> <currency>". Non-INR goals are converted at live rates.
GOALS=10000000 INR,175000 USD,240000 USD
# Month the financial year starts (4 = April)
FY_START_MONTH=4
# Time zone used to decide which day/month an order falls in
TIMEZONE=Asia/Kolkata
# Only used if both live exchange-rate services are unreachable
USD_INR_RATE=88

# Set to true to run with generated demo data (no Odoo calls)
DEMO_MODE=false
